        <mxCell id="phase4-label" value="&lt;b&gt;PHASE 4: Client Reconciliation&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#4a235a;" vertex="1" parent="1">
          <mxGeometry x="80" y="2135" width="400" height="25" as="geometry" />
        </mxCell>

        <!-- P2 reconciliation -->
        <mxCell id="p2-act4" value="" style="shape=umlActivation;html=1;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;participant=p2-header;" vertex="1" parent="1">
          <mxGeometry x="940" y="2180" width="20" height="420" as="geometry" />
        </mxCell>

        <mxCell id="p2-rec1" value="RECONCILE arrives&lt;br&gt;StateManager.processReconcile()&lt;br&gt;→ discard acknowledged inputs" style="text;html=1;strokeColor=#82b366;fillColor=#e8f5e9;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="740" y="2190" width="220" height="40" as="geometry" />
        </mxCell>

        <mxCell id="p2-rec2" value="StateManager.repredict()&lt;br&gt;→ replay remaining inputs&lt;br&gt;from authoritative base state" style="text;html=1;strokeColor=#82b366;fillColor=#e8f5e9;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="740" y="2245" width="220" height="40" as="geometry" />
        </mxCell>

        <mxCell id="p2-rec3" value="CharacterController.reconcile()&lt;br&gt;correctionOffset =&lt;br&gt;authoritative.pos − predicted.pos" style="text;html=1;strokeColor=#82b366;fillColor=#e8f5e9;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="740" y="2300" width="220" height="45" as="geometry" />
        </mxCell>

        <mxCell id="p2-rec-note" value="&lt;b&gt;Each subsequent frame:&lt;/b&gt;&lt;br&gt;pos += offset × (1−e^(−20·Δt))&lt;br&gt;offset ×= e^(−20·Δt)&lt;br&gt;&lt;br&gt;When offset &lt; 0.0001 → null&lt;br&gt;(smooth exponential lerp)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f3e5f5;strokeColor=#9673a6;size=14;align=left;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="740" y="2370" width="210" height="80" as="geometry" />
        </mxCell>

        <!-- P1 reconciliation (minor) -->
        <mxCell id="p1-act4" value="" style="shape=umlActivation;html=1;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;participant=p1-header;" vertex="1" parent="1">
          <mxGeometry x="160" y="2180" width="20" height="140" as="geometry" />
        </mxCell>

        <mxCell id="p1-rec1" value="RECONCILE arrives&lt;br&gt;Corrects minor horizontal push&lt;br&gt;from Phase 1 prediction&lt;br&gt;(sub-pixel, consumed quickly)" style="text;html=1;strokeColor=#6c8ebf;fillColor=#e3edf9;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="60" y="2190" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- Final note -->
        <mxCell id="final-note" value="✅ &lt;b&gt;Both clients converged to authoritative server state&lt;/b&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#e8f5e9;strokeColor=#82b366;size=14;align=center;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="2520" width="360" height="50" as="geometry" />
        </mxCell>

        <!-- ===== LEGEND ===== -->
        <mxCell id="legend-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="2610" width="520" height="120" as="geometry" />
        </mxCell>
        <mxCell id="legend-label" value="&lt;b&gt;Key Mechanisms (repeated per tick)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="2615" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="legend-content" value="1️⃣ &lt;b&gt;resolvePlayerOverlaps()&lt;/b&gt; — pushes P2 up as P1 rises (Y-axis)&lt;br&gt;2️⃣ &lt;b&gt;Re-grounding pass&lt;/b&gt; (GameWorld.js:380-405) — restores P2.isGrounded=true after push&lt;br&gt;3️⃣ &lt;b&gt;checkPlayerOnAnyPlayer()&lt;/b&gt; — proximity check for head-standing (Δ ≤ 0.06)&lt;br&gt;⚠️ Without either mechanism: P2 falls through P1 (gravity activates on next tick)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="340" y="2640" width="480" height="80" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
